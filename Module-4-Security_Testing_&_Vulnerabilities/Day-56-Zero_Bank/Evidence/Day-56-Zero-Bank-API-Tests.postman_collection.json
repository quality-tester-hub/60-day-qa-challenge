    {
      "name": "GET Authenticated Page (Login Verification)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code is 200\", function () {\n    pm.response.to.have.status(200);\n});\npm.test(\"Authenticated nav is present - username shown\", function () {\n    pm.expect(pm.response.text()).to.include(\"username\");\n});\npm.test(\"Logout link is present - session is active\", function () {\n    pm.expect(pm.response.text()).to.include(\"logout_link\");\n});\npm.test(\"Account Summary content loads\", function () {\n    pm.expect(pm.response.text()).to.include(\"Account Summary\");\n});\n// Store cookie for subsequent requests\npm.environment.set(\"cookie\", \"username=\" + pm.environment.get(\"username\") + \"; password=\" + pm.environment.get(\"password\"));"
            ]
          }
        },
