              "});",
              "pm.test(\"Invalid login does not show authenticated nav\", function () {",
              "    pm.expect(pm.response.text()).to.not.include(\"logout_link\");",
              "});",
              "pm.test(\"Login page is shown again or error is present\", function () {",
              "    const body = pm.response.text();",
              "    const hasLoginForm = body.includes(\"login_form\") || body.includes(\"signin.html\") || body.includes(\"Login\") || body.includes(\"error\");",
              "    pm.expect(hasLoginForm).to.be.true;",
              "});"
            ]
          }
        }
      ],
